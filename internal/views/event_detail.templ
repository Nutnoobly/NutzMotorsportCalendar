package views

import (
	"fmt"
	"github.com/Nutnoobly/NutzMotorsportCalendar/internal/db"
)

templ EventDetail(event db.GetEventBySlugRow, sessions []db.Session, results []db.ListResultsByEventIDRow) {
	@Layout(event.EventName) {
		<div class="space-y-8 max-w-5xl mx-auto">
			<!-- Back Navigation -->
			<div>
				<a
					href="/"
					class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-white transition-colors"
				>
					<span>&larr;</span> Back to Calendar
				</a>
			</div>

			<!-- Event Header Card -->
			<div class="rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 p-6 sm:p-8 shadow-2xl">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
					<div class="space-y-2">
						<div class="flex items-center gap-2.5 flex-wrap">
							<span class={ "px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider", SeriesBadgeClass(event.SerieID) }>
								{ event.SerieID }
							</span>
							<span class="text-xs font-semibold text-slate-400">
								Season { fmt.Sprintf("%d", event.EventSeason) } &bull; Round { fmt.Sprintf("%d", event.EventRound) }
							</span>
							<span class={ "px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider", StatusBadgeClass(event.EventStatus) }>
								{ event.EventStatus }
							</span>
						</div>

						<h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
							{ event.EventName }
						</h1>

						<p class="text-sm sm:text-base text-slate-400 flex items-center gap-2">
							<span>📍</span>
							<span class="text-white font-medium">{ event.CircuitName }</span>
							if TextString(event.CircuitLocality, "") != "" {
								<span>&bull;</span>
								<span>{ TextString(event.CircuitLocality, "") }</span>
							}
							if TextString(event.CircuitCountry, "") != "" {
								<span>&bull;</span>
								<span>{ TextString(event.CircuitCountry, "") }</span>
							}
						</p>
					</div>

					<div class="sm:text-right shrink-0">
						<div class="text-sm uppercase tracking-wider text-slate-400 font-semibold">Race Weekend</div>
						<div class="text-lg font-bold text-white font-mono mt-0.5">
							{ FormatDate(event.EventStartsAt) }
						</div>
						<div class="text-xs text-slate-400" data-utc={ ISOTimestamp(event.EventStartsAt) }>
							{ FormatTimeUTC(event.EventStartsAt) }
						</div>
					</div>
				</div>

				<!-- Official Links -->
				if TextString(event.EventOfficialUrl, "") != "" || TextString(event.EventTicketUrl, "") != "" {
					<div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center gap-4 flex-wrap">
						if TextString(event.EventOfficialUrl, "") != "" {
							<a
								href={ templ.SafeURL(TextString(event.EventOfficialUrl, "#")) }
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 text-xs font-medium text-red-400 hover:text-red-300 underline underline-offset-4"
							>
								Official Event Site &nearr;
							</a>
						}
						if TextString(event.EventTicketUrl, "") != "" {
							<a
								href={ templ.SafeURL(TextString(event.EventTicketUrl, "#")) }
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-400 hover:text-amber-300 underline underline-offset-4"
							>
								Buy Tickets &nearr;
							</a>
						}
					</div>
				}
			</div>

			<!-- Grid: Timetable & Podium Results -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
				<!-- Weekend Timetable -->
				<section class="lg:col-span-6 space-y-4">
					<div class="flex items-center justify-between">
						<h2 class="text-lg font-bold text-white flex items-center gap-2">
							<span>⏱️</span> Weekend Timetable
						</h2>
						<span class="text-xs text-slate-500 font-mono">Times in UTC</span>
					</div>

					if len(sessions) == 0 {
						<div class="rounded-xl border border-slate-800 bg-slate-900/30 p-6 text-center text-sm text-slate-400">
							No session timetable published yet.
						</div>
					} else {
						<div class="rounded-xl border border-slate-800/80 bg-slate-900/40 divide-y divide-slate-800/60 overflow-hidden">
							for _, sess := range sessions {
								<div class="p-4 flex items-center justify-between hover:bg-slate-900/60 transition-colors">
									<div>
										<span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">
											{ sess.SessionKind }
										</span>
										<span class="text-sm font-semibold text-white">
											{ sess.SessionName }
										</span>
									</div>
									<div class="text-right">
										<span class="text-xs font-mono font-medium text-slate-300 block">
											{ FormatDate(sess.SessionStartsAt) }
										</span>
										<span class="text-xs font-mono text-slate-400" data-utc={ ISOTimestamp(sess.SessionStartsAt) }>
											{ FormatTimeUTC(sess.SessionStartsAt) }
										</span>
									</div>
								</div>
							}
						</div>
					}
				</section>

				<!-- Official Results / Podium -->
				<section class="lg:col-span-6 space-y-4">
					<div class="flex items-center justify-between">
						<h2 class="text-lg font-bold text-white flex items-center gap-2">
							<span>🏆</span> Podium &amp; Results
						</h2>
						if len(results) > 0 {
							<span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
								Official
							</span>
						}
					</div>

					if len(results) == 0 {
						<div class="rounded-xl border border-dashed border-slate-800 bg-slate-900/20 p-8 text-center">
							<div class="text-2xl mb-2">🏁</div>
							<p class="text-sm font-medium text-white">Results Pending</p>
							<p class="text-xs text-slate-400 mt-1">
								Podium standings and classification will appear here following the race.
							</p>
						</div>
					} else {
						<!-- Results List -->
						<div class="space-y-3">
							for _, res := range results {
								<div class={ "rounded-xl border p-4 flex items-center justify-between",
									templ.KV("border-amber-500/40 bg-amber-500/5", res.ResultPosition == 1),
									templ.KV("border-slate-400/30 bg-slate-400/5", res.ResultPosition == 2),
									templ.KV("border-amber-700/40 bg-amber-700/5", res.ResultPosition == 3),
									templ.KV("border-slate-800 bg-slate-900/40", res.ResultPosition > 3) }>
									<div class="flex items-center gap-3.5">
										<!-- Position Badge -->
										<div class={ "w-9 h-9 rounded-lg flex items-center justify-center font-mono text-base border", PositionBadgeClass(res.ResultPosition) }>
											{ fmt.Sprintf("%d", res.ResultPosition) }
										</div>

										<!-- Driver & Team Details -->
										<div>
											<div class="flex items-center gap-1.5">
												<span class="text-sm font-bold text-white">
													{ res.DriverFirstName } { res.DriverLastName }
												</span>
												if TextString(res.DriverCode, "") != "" {
													<span class="text-[11px] font-mono text-slate-400 font-semibold">
														({ TextString(res.DriverCode, "") })
													</span>
												}
											</div>
											<div class="text-xs text-slate-400 flex items-center gap-1.5 mt-0.5">
												<span>{ res.TeamName }</span>
												if res.DriverNumber.Valid {
													<span>&bull;</span>
													<span class="font-mono">#{ fmt.Sprintf("%d", res.DriverNumber.Int32) }</span>
												}
											</div>
										</div>
									</div>

									<!-- Gap & Points -->
									<div class="text-right">
										<div class="text-xs font-mono font-medium text-slate-300">
											{ TextString(res.ResultTimeOrGap, "Leader") }
										</div>
										if res.ResultPoints.Valid && res.ResultPoints.Float64 > 0 {
											<div class="text-[11px] font-mono text-emerald-400 font-semibold mt-0.5">
												+{ FloatString(res.ResultPoints) } pts
											</div>
										}
									</div>
								</div>
							}
						</div>
					}
				</section>
			</div>
		</div>
	}
}
