# 1. Connection Pooler - Session Mode (RECOMMENDED for Go / pgx, IPv4 compatible):
# Supabase Dashboard -> Connect -> Connection Pooling -> Mode: Session (port 5432)
# Note: Username MUST be postgres.<project-ref> (e.g. postgres.ctiwpxwvnpmglwsafnzp)
DATABASE_URL="postgresql://postgres.ctiwpxwvnpmglwsafnzp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Connection Pooler - Transaction Mode (port 6543, requires disabling prepared statements):
# DATABASE_URL="postgresql://postgres.ctiwpxwvnpmglwsafnzp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# 3. Direct connection (Requires IPv6 network support):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ctiwpxwvnpmglwsafnzp.supabase.co:5432/postgres"

# Admin secret used to authenticate POST /admin/refresh (e.g. GitHub Actions cron)
ADMIN_SECRET="your-super-secret-key"
